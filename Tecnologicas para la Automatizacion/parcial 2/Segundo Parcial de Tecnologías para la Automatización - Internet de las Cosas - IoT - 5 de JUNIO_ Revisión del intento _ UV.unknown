.table { width: 100%; margin-bottom: 1rem; color: rgb(29, 33, 37); }

.table th, .table td { padding: 0.75rem; vertical-align: top; border-top: 1px solid rgb(222, 226, 230); }

.table thead th { vertical-align: bottom; border-bottom: 2px solid rgb(222, 226, 230); }

.table tbody + tbody { border-top: 2px solid rgb(222, 226, 230); }

.table-sm th, .table-sm td { padding: 0.3rem; }

.table-bordered { border: 1px solid rgb(222, 226, 230); }

.table-bordered th, .table-bordered td { border: 1px solid rgb(222, 226, 230); }

.table-bordered thead th, .table-bordered thead td { border-bottom-width: 2px; }

.table-borderless th, .table-borderless td, .table-borderless thead th, .table-borderless tbody + tbody { border: 0px; }

.table-striped tbody tr:nth-of-type(2n+1) { background-color: rgba(0, 0, 0, 0.03); }

.table-hover tbody tr:hover { color: rgb(29, 33, 37); background-color: rgba(0, 0, 0, 0.075); }

.table-primary, .table-primary > th, .table-primary > td { background-color: rgb(188, 214, 237); }

.table-primary th, .table-primary td, .table-primary thead th, .table-primary tbody + tbody { border-color: rgb(130, 179, 222); }

.table-hover .table-primary:hover { background-color: rgb(168, 202, 232); }

.table-hover .table-primary:hover > td, .table-hover .table-primary:hover > th { background-color: rgb(168, 202, 232); }

.table-secondary, .table-secondary > th, .table-secondary > td { background-color: rgb(241, 243, 245); }

.table-secondary th, .table-secondary td, .table-secondary thead th, .table-secondary tbody + tbody { border-color: rgb(230, 233, 236); }

.table-hover .table-secondary:hover { background-color: rgb(226, 230, 234); }

.table-hover .table-secondary:hover > td, .table-hover .table-secondary:hover > th { background-color: rgb(226, 230, 234); }

.table-success, .table-success > th, .table-success > td { background-color: rgb(198, 218, 198); }

