.tool-card [contenteditable="true"]:focus { outline: 0px; border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset, rgba(82, 168, 236, 0.6) 0px 0px 8px; background-color: rgb(255, 255, 255); border: 1px solid rgba(82, 168, 236, 0.8); transition: border 0.2s linear, box-shadow 0.2s linear; cursor: text; }

