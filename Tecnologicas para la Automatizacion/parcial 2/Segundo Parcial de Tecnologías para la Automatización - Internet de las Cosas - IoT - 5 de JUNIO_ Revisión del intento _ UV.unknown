.navbar .popover-region-container { top: 50px; }

.content-item-container { width: 100%; border-bottom: 1px solid rgb(221, 221, 221); box-sizing: border-box; padding: 5px; position: relative; margin: 0px; display: block; color: inherit; text-decoration: none; }

.content-item-container:hover { color: rgb(255, 255, 255); background-color: rgb(15, 108, 191); }

